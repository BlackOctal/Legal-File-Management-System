{
  "name": "law-case-backend",
  "version": "1.0.0",
  "description": "Backend for Law Case Management System with AWS S3 Integration",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest",
    "test:s3": "node scripts/testS3Connection.js",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "init-admins": "node scripts/initializeAdmins.js",
    "seed": "node scripts/seedDatabase.js",
    "backup": "node scripts/backupDatabase.js",
    "migrate-s3": "node scripts/migrateToS3.js",
    "health-check": "node scripts/healthCheck.js",
    "lint": "eslint . --ext .js",
    "lint:fix": "eslint . --ext .js --fix"
  },
  "dependencies": {
    "aws-sdk": "^2.1692.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "cron": "^3.5.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "moment": "^2.29.4",
    "mongoose": "^8.0.3",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "multer-s3": "^3.0.1",
    "resend": "^3.5.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "sharp": "^0.34.3",
    "supertest": "^6.3.3"
  },
  "keywords": [
    "law",
    "case-management",
    "legal",
    "nodejs",
    "mongodb",
    "aws-s3",
    "resend",
    "document-management"
  ],
  "author": "Law Firm Development Team",
  "license": "MIT",
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "your-repository-url"
  },
  "nodemonConfig": {
    "ignore": [
      "uploads/",
      "logs/",
      "*.test.js"
    ],
    "env": {
      "NODE_ENV": "development"
    }
  },
  "jest": {
    "testEnvironment": "node",
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "**/*.js",
      "!node_modules/**",
      "!coverage/**",
      "!uploads/**"
    ]
  }
}

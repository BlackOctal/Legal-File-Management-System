# Server Configuration
PORT=5001
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/law_case_system

# JWT Secret
JWT_SECRET=your_super_secret_jwt_key_here_change_this_in_production
JWT_EXPIRES_IN=7d

# Frontend URL
FRONTEND_URL=http://localhost:3000

# AWS S3 Configuration
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=law-case-documents

# Resend Email Configuration
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=noreply@yourdomain.com
EMAIL_FROM_NAME=Law Case Management System

# Fixed Admin Credentials (Hardcoded)
SUPER_ADMIN_NAME=Super Administrator
SUPER_ADMIN_EMAIL=superadmin@lawfirm.com
SUPER_ADMIN_PASSWORD=SuperAdmin123!

ADMIN1_NAME=Primary Admin
ADMIN1_EMAIL=admin1@lawfirm.com
ADMIN1_PASSWORD=Admin123!

ADMIN2_NAME=Secondary Admin
ADMIN2_EMAIL=admin2@lawfirm.com
ADMIN2_PASSWORD=Admin123!

# Rate Limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100

# Notification Settings
ENABLE_EMAIL_NOTIFICATIONS=true
NOTIFICATION_RETENTION_DAYS=30